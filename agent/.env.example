# ── Chain ──
RPC_URL=https://testnet.monad.xyz
CHAIN_ID=10143

# ── Agent Wallet ──
AGENT_PRIVATE_KEY=0x_your_private_key_here
AGENT_ADDRESS=0x_your_agent_address

# ── Contract Addresses (update after deployment) ──
TREATY_CONTRACT=0x0000000000000000000000000000000000000000
CONSTITUTION_REGISTRY=0x0000000000000000000000000000000000000000
MEDIATOR_SWARM=0x0000000000000000000000000000000000000000

# ── Cleanverse API (update after registration) ──
CLEANVERSE_API_BASE=https://api.cleanverse.com/v3
CLEANVERSE_API_KEY=your_api_key_here
CLEANVERSE_SANDBOX=true

# ── Oracle Addresses ──
CVI_ORACLE=0x0000000000000000000000000000000000000000
CVA_ORACLE=0x0000000000000000000000000000000000000000
CCP_GATEWAY=0x0000000000000000000000000000000000000000

# ── Mediator Agent Addresses ──
MEDIATOR_1_ADDRESS=0x0000000000000000000000000000000000000000
MEDIATOR_2_ADDRESS=0x0000000000000000000000000000000000000000
MEDIATOR_3_ADDRESS=0x0000000000000000000000000000000000000000

# ── Monitoring ──
MONITOR_INTERVAL_MS=15000
MAX_TREATIES_PER_CYCLE=50
DEGRADATION_THRESHOLD_PERCENT=10
MAX_CONSECUTIVE_DEGRADATION=3
BREACH_GRACE_BLOCKS=7200

# ── Server ──
STATUS_PORT=3001
